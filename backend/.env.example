# ============================================================
#  Shax Store — Backend Environment Variables (EXAMPLE)
#  Copy this file to `.env` and fill in real values.
#  NEVER commit `.env` — it contains secrets.
# ============================================================

# ── Database (MySQL) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=shaxstore

# ── Security ──────────────────────────────────────────────
# Used to sign JWT tokens. MUST be at least 32 characters long.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── Initial admin account (used only by `npm run seed`) ───
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@shaxstore.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ── Server ────────────────────────────────────────────────
# Port the API listens on (default 3000).
PORT=3000
# Comma-separated list of origins allowed by CORS. In production
# set this to your real domain (a bare `*` is rejected in production).
ALLOWED_ORIGIN=http://localhost:3000

# Public base URL used to build absolute image links in Telegram
# order notifications. Leave empty for relative URLs on localhost.
PUBLIC_BASE_URL=

# ── Telegram notifications (optional) ─────────────────────
# Bot token + chat id for order/marketing Telegram messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Firebase / native push (optional) ─────────────────────
# Provide ONE of the following to enable FCM pushes.
#   FIREBASE_SERVICE_ACCOUNT_B64  — your Firebase service-account JSON
#                                   encoded as base64 (easiest on PaaS:
#                                   `base64 -w0 serviceAccount.json`).
#   FIREBASE_SERVICE_ACCOUNT_PATH — absolute path to the downloaded
#                                   service-account JSON on the server.
# Leave BOTH empty to keep native push in "dry-run" mode: the admin
# Push page still shows diagnostics and projections, but no device
# notifications are sent (in-app notifications keep working).
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Alternative Firebase configuration (optional) — only used when the
# two variables above are both empty. Read by Google Auth Libraries.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCLOUD_PROJECT=your-firebase-project-id